# SITE_ADDRESS contoh: inbox.perusahaan.com (Caddy otomatis ambil sertifikat Let's Encrypt)
# Untuk uji lokal tanpa TLS: SITE_ADDRESS=:80
{$SITE_ADDRESS}

encode gzip

# API + WebSocket + healthcheck ke backend Go
handle /api/* {
	reverse_proxy backend:8080
}
handle /ws {
	reverse_proxy backend:8080
}
handle /healthz {
	reverse_proxy backend:8080
}

# Frontend Next.js (standalone server)
handle {
	reverse_proxy frontend:3000
}
