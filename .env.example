# Salin ke .env di VPS (chmod 600). JANGAN commit .env.

# Koneksi ke PostgreSQL yang sudah ada di infra
POSTGRES_DSN=postgres://user:password@host:5432/sales_inbox?sslmode=disable

# Domain publik aplikasi (Caddy auto-TLS). Uji lokal: ":80"
SITE_ADDRESS=inbox.perusahaan.com

# Origin frontend untuk CORS/WS saat dev terpisah; di produksi same-origin isi dengan https://SITE_ADDRESS
FRONTEND_ORIGIN=https://inbox.perusahaan.com

# Prefix nama admin di pesan keluar: on (default) / off
AGENT_SIGNATURE=on
